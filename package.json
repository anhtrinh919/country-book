{
  "name": "country-book",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:fr": "VITE_LANG=fr VITE_YOUNG=1 vite build --outDir dist-fr",
    "preview": "vite preview",
    "preview:fr": "vite preview --outDir dist-fr",
    "check:overflow": "tsx scripts/check-overflow.ts",
    "check:print": "tsx scripts/check-print-overflow.ts",
    "build:pdf": "tsx scripts/build-pdf.ts",
    "build:pdf:proof": "PRESET=proof tsx scripts/build-pdf.ts",
    "build:pdf:all": "tsx scripts/build-pdf.ts && PRESET=proof tsx scripts/build-pdf.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "react-simple-maps": "^3.0.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/react-simple-maps": "^3.0.6",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^4.3.1",
    "ajv": "^8.17.1",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.47.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.5",
    "vite-plugin-pwa": "^1.3.0"
  }
}
